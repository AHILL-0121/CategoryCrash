# ─── Client (browser) ───
# PartyKit host the game connects to over WebSocket.
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Public origin of the deployed site. Used as `metadataBase`, so Open Graph and
# Twitter share images resolve to a real URL instead of localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Next.js server (API routes) ───
# Groq API key used by /api/get-possible-answers and /api/validate-answer.
GROQ_API_KEY=your_groq_api_key_here

# Shared secret the PartyKit server presents as `x-internal-key`. The AI routes
# spend Groq tokens on every call, so they are not public.
# REQUIRED IN PRODUCTION — the routes return 503 without it.
# Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Comma-separated browser origins allowed to call the AI routes.
# Leave blank for local development.
ALLOWED_ORIGINS=

# ─── Cloudflare Worker (game server) ───
# The Worker reads BACKEND_URL (set in wrangler.jsonc "vars" or with
# `wrangler deploy --var BACKEND_URL:https://your-app.vercel.app`) to reach the
# Next.js API. Its default http://localhost:3000 does not exist once deployed —
# AI validation silently no-ops in production if it is unset.
# For production host use the workers.dev host, e.g.
# NEXT_PUBLIC_PARTYKIT_HOST=categorycrash.<account>.workers.dev
# INTERNAL_API_SECRET is stored with: npx wrangler secret put INTERNAL_API_SECRET
