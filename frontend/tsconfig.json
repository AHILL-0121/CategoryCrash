{
  "compilerOptions": {
    // Required for the unicode regex flag in lib/answer-matching.ts.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    // node --experimental-strip-types resolves the real .ts paths, so the
    // test files import with explicit extensions.
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
